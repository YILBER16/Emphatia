# Vertex AI is disabled unless explicitly enabled.
VERTEX_AI_ENABLED=false
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# Gemini API key. Use this when your Google Console setup authenticates with an API key.
# GOOGLE_API_KEY=

# Path to a Google Cloud service-account JSON key. Do not commit the real file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/vertex-service-account.json